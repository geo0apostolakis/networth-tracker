# Copy this file to .env.local, fill it in, then `npm run dev`.
# .env.local is gitignored — never commit real values.
# Set the same variables in your deployment host (e.g. Vercel → Settings →
# Environment Variables) or the deployed app will not start.

# --- Supabase (REQUIRED) -----------------------------------------------------
# Your own project: supabase.com → New project → Settings → API.
# Run supabase/setup.sql in that project's SQL editor before first launch.
# The service_role key bypasses RLS and is used server-side only — it must never
# be exposed to the browser or committed.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Dashboard login (REQUIRED) ----------------------------------------------
# /login guards every page and every /api route. Passkeys (Touch ID / Face ID)
# are added from the login page after a first password sign-in; the password
# stays as the fallback. Without these three set, every route answers 401 and
# the login answers 503: the app fails closed, never open.
ADMIN_USER=
ADMIN_PASSWORD=
# Signs the 30-day session cookie. 32+ random characters, e.g.
#   openssl rand -base64 48
# Changing it signs every browser out.
AUTH_SECRET=

# --- Personalisation (optional) ----------------------------------------------
# Name on the intro splash and mobile lock screen. Baked into the client bundle,
# so treat it as public — a display name, never anything sensitive.
NEXT_PUBLIC_OWNER_NAME=

# IANA timezone deciding which calendar day a daily snapshot belongs to.
# NEXT_PUBLIC_APP_TZ=Europe/Athens

# --- Freedom24 / Tradernet brokerage sync (optional) -------------------------
# Generate your OWN key pair in your Freedom24 account under the API section.
# These stay on the server. Leave blank to skip brokerage sync — everything else
# works without them.
FREEDOM24_PUBLIC_KEY=
FREEDOM24_PRIVATE_KEY=

# Optional: override the API host if Freedom24 tells you a different one.
# Default: https://tradernet.com/api  (the Python SDK uses https://tradernet.ru/api)
# FREEDOM24_API_URL=https://tradernet.com/api

# --- Revolut via Enable Banking (optional) -----------------------------------
# Personal Revolut has no public API; Open Banking through enablebanking.com is
# the legal path and its Restricted Production tier is free for accounts you
# link yourself. Register an application in their control panel, upload the
# certificate from:  openssl req -x509 -newkey rsa:4096 -keyout private.pem
#                    -out cert.pem -days 3650 -nodes
# and set the redirect URL to <APP_URL>/api/revolut/callback.
ENABLE_BANKING_APP_ID=
# base64 of private.pem (base64 -w0 private.pem), or the raw PEM with \n.
ENABLE_BANKING_PRIVATE_KEY=
# Public origin of the deployed app, used to build the consent redirect.
APP_URL=

# Crypto wallets need no keys: balances come from public chain RPCs and prices
# from CoinGecko's keyless endpoint.
